# ============================================================
# Environment Configuration Example
# Copy to .env or set in your container/environment
# ============================================================

# Frontend Configuration
# URL of the backend API for client requests
VITE_API_BASE=http://localhost:8000

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

# Finite State Machine Stability Thresholds (Optional overrides)
# FSM_THRESHOLD_TO_DEGRADED=0.6
# FSM_THRESHOLD_TO_CRITICAL=0.3
# FSM_THRESHOLD_DEGRADED_TO_NORMAL=0.8
# FSM_THRESHOLD_CRITICAL_TO_DEGRADED=0.5
